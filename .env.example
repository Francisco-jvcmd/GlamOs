# ── Postgres (Neon / Production Security Model) ──────────────
# 1. URL de Migraciones (Rol Dueño / DDL):
#    Usada solo para 'pnpm db:migrate'. Es dueña de las tablas y aplica FORCE RLS.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:password@ep-...neon.tech/neondb?sslmode=require

# 2. URL de Runtime de la API (Rol glamos_app / DML):
#    Usada por NestJS en runtime. NO es dueña de tablas, NO tiene BYPASSRLS.
#    Si alguna query se ejecuta sin withTenant(), current_setting devuelve NULL y Postgres
#    retorna 0 filas (FALLA SEGURO / FAIL-CLOSED).
DATABASE_URL=postgresql://glamos_app:glamos_app_password@ep-...neon.tech/neondb?sslmode=require

# ── Auth (Google Cloud Console) ─────────────────────────
# NOTA CRÍTICA: Ambos client IDs DEBEN crearse en el MISMO proyecto de Google Cloud.
# En Android, registra tanto el SHA-1 de Debug como el SHA-1 de Release (keystore firmado).
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
JWT_ACCESS_SECRET=generate-a-strong-random-secret-here
JWT_REFRESH_SECRET=generate-another-strong-random-secret-here

# ── Tenant join codes ────────────────────────────
# Pepper del servidor para HMAC-SHA256 (SOLO backend, nunca cliente/shared)
JOIN_CODE_PEPPER=generate-a-random-pepper-for-hmac

# ── Cloudflare R2 ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=glamos-uploads
R2_PUBLIC_URL=

# ── AI (house provider) ─────────────────────────
AI_HOUSE_PROVIDER_KEY=
AI_ENCRYPTION_KEY=generate-32-byte-hex-for-aes256gcm

# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
